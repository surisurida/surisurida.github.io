{
  "name": "surisurida.github.io",
  "description": "수리의 홈페이지",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "docs:build": "vuepress-vite build src",
    "docs:clean-dev": "vuepress-vite dev src --clean-cache",
    "docs:dev": "vuepress-vite dev src",
    "docs:update-package": "pnpm dlx vp-update",
    "news:update": "uv run scripts/fetch_news.py",
    "market:update": "uv run scripts/write_market_brief.py",
    "update:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_local_update.ps1",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "sass-embedded": "^1.105.0",
    "vue": "^3.5.43",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.110"
  }
}
